# =======================================================
# SQD Indexer Configuration
# =======================================================

# Entity Types Configuration (comma-separated)
# Available types: blocks,transactions,logs,transfers,native_balances,balance_increases,balance_decreases
# Default: transfers,balance_increases,balance_decreases
ENTITY_TYPES=transfers,balance_increases,balance_decreases

# Output Destinations (comma-separated URLs)
# Examples:
# ClickHouse only: OUTPUT=clickhouse+http://username:password@localhost:8123/database
# ClickHouse + AMQP: OUTPUT=clickhouse+http://user:pass@ch-host:8123/db,amqp://admin:admin@localhost:5672/dex
# Multiple destinations: OUTPUT=clickhouse+http://user:pass@ch1:8123/db1,clickhouse+http://user:pass@ch2:8123/db2,amqp://user:pass@mq:5672/vhost
OUTPUT=clickhouse+http://default:@localhost:8123/base

# Network Configuration (Required)
GATEWAY_URL=https://v2.archive.subsquid.io/network/ethereum-mainnet
RPC_ETH_HTTP=https://rpc.ankr.com/eth
RPC_ETH_RATE_LIMIT=10

# Processing Configuration
BATCH_SIZE=100
BALANCE_CHANGES_TTL_DAYS=90

# ClickHouse Retry Configuration
CLICKHOUSE_TIMEOUT=30000
CLICKHOUSE_MAX_RETRIES=3
CLICKHOUSE_RETRY_DELAY=1000
CLICKHOUSE_MAX_RETRY_DELAY=10000

# AMQP Configuration (fallback if not specified in OUTPUT)
# Note: AMQP is automatically enabled if amqp:// URL is present in OUTPUT
AMQP_URL=amqp://guest:guest@localhost:5672
QUEUE_NAME=block_batches
EXCHANGE_NAME=
ROUTING_KEY=blocks.batch

# Legacy Environment Variables (for backward compatibility)
# These are used as fallbacks if OUTPUT parsing fails
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=base

# Legacy RabbitMQ variables (for backward compatibility)
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_QUEUE=block_batches
RABBITMQ_EXCHANGE=
RABBITMQ_ROUTING_KEY=blocks.batch

# =======================================================
# Configuration Examples
# =======================================================

# Example 1: Minimal setup (transfers only)
# ENTITY_TYPES=transfers
# OUTPUT=clickhouse+http://default:@localhost:8123/ethereum

# Example 2: Full indexing with balance tracking
# ENTITY_TYPES=blocks,transactions,logs,transfers,native_balances,balance_increases,balance_decreases
# OUTPUT=clickhouse+http://user:pass@production-ch:8123/ethereum

# Example 3: Multi-destination setup
# ENTITY_TYPES=transfers,balance_increases,balance_decreases
# OUTPUT=clickhouse+http://user:pass@primary-ch:8123/ethereum,clickhouse+http://user:pass@backup-ch:8123/ethereum,amqp://admin:secret@rabbitmq:5672/indexer

# Example 4: Development setup with local services
# ENTITY_TYPES=transfers,balance_increases,balance_decreases
# OUTPUT=clickhouse+http://default:@localhost:8123/dev,amqp://guest:guest@localhost:5672 